<h2>Objednávka — údaje k dodání</h2>
<% if (items.length === 0) { %>
  <p>Košík je prázdný. <a href="/">Pokračovat v nákupu</a></p>
<% } else { %>
  <ul>
    <% items.forEach(it => { %>
      <li><%= it.product.title %> — <%= it.qty %> × <%= it.product.price.toFixed(2) %> Kč = <%= it.subtotal.toFixed(2) %> Kč</li>
    <% }) %>
  </ul>
  <p class="total">Celkem: <strong><%= total.toFixed(2) %> Kč</strong></p>

  <form method="post" action="/checkout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Jméno a příjmení<br/><input name="name" required /></label><br/>
    <label>E‑mail<br/><input name="email" type="email" required /></label><br/>
    <label>Adresa<br/><textarea name="address" required></textarea></label><br/>
    <button type="submit">Odeslat objednávku (demo)</button>
  </form>
<% } %>
